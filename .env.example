# Database Configuration (SQLite by default, swappable to PostgreSQL/MySQL)
DATABASE_URL="file:./dev.db"

# Session Security (Generate a secure random key of >= 32 characters in production)
SESSION_SECRET="replace-with-a-secure-random-32-character-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Demo Mode Configuration
NEXT_PUBLIC_DEMO_MODE=true
SEED_DEMO_CASES=false

# Seeded Demo Accounts (Required for demo testing, passwords must be >= 10 characters)
DEMO_CUSTOMER_EMAIL="customer@harbingergroup.com"
